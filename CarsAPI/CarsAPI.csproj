    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
